{
	"name": "home-storage",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build",
		"dev": "node ace serve --hmr",
		"test": "node ace test",
		"lint": "eslint .",
		"format": "npx dprint fmt",
		"typecheck": "tsc --noEmit"
	},
	"imports": {
		"#controllers/*": "./app/controllers/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#models/*": "./app/models/*.js",
		"#mails/*": "./app/mails/*.js",
		"#services/*": "./app/services/*.js",
		"#listeners/*": "./app/listeners/*.js",
		"#events/*": "./app/events/*.js",
		"#rules/*": "./app/rules/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#validators/*": "./app/validators/*.js",
		"#providers/*": "./providers/*.js",
		"#policies/*": "./app/policies/*.js",
		"#abilities/*": "./app/abilities/*.js",
		"#database/*": "./database/*.js",
		"#generated/*": "./.adonisjs/server/*.js",
		"#transformers/*": "./app/transformers/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^8.4.0",
		"@adonisjs/eslint-config": "^3.0.0",
		"@adonisjs/prettier-config": "^1.4.5",
		"@adonisjs/tsconfig": "^2.0.0",
		"@eslint/js": "^9.32.0",
		"@japa/assert": "^4.0.1",
		"@japa/plugin-adonisjs": "^5.2.0",
		"@japa/runner": "^4.2.0",
		"@poppinss/ts-exec": "^1.4.4",
		"@stylistic/eslint-plugin": "^5.2.2",
		"@swc/core": "1.11.24",
		"@types/luxon": "^3.6.2",
		"@types/node": "^22.15.18",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.7.0",
		"eslint": "^9.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"hot-hook": "^0.4.0",
		"pino-pretty": "^13.0.0",
		"prettier": "^3.5.3",
		"ts-node-maintained": "^10.9.5",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.38.0",
		"vite": "^7.0.0"
	},
	"dependencies": {
		"@adonisjs/auth": "^10.0.0",
		"@adonisjs/core": "^7.3.0",
		"@adonisjs/cors": "^3.0.0",
		"@adonisjs/drive": "^4.0.0",
		"@adonisjs/i18n": "^3.0.0",
		"@adonisjs/inertia": "^4.2.0",
		"@adonisjs/lucid": "^22.4.2",
		"@adonisjs/session": "^8.0.0",
		"@adonisjs/shield": "^9.0.0",
		"@adonisjs/static": "^2.0.1",
		"@adonisjs/vite": "^5.1.0",
		"@ant-design/icons": "^6.1.0",
		"@inertiajs/react": "^2.0.17",
		"@jrmc/adonis-attachment": "^5.1.2",
		"@vinejs/vine": "^4.3.1",
		"@zxing/library": "^0.21.3",
		"antd": "^6.3.0",
		"axios": "^1.13.5",
		"dprint": "^0.50.1",
		"edge.js": "^6.5.0",
		"luxon": "^3.7.1",
		"pg": "^8.16.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"reflect-metadata": "^0.2.2",
		"yaml": "^2.8.3"
	},
	"hotHook": {
		"boundaries": [
			"./app/controllers/**/*.ts",
			"./app/middleware/*.ts"
		]
	},
	"prettier": "@adonisjs/prettier-config"
}
